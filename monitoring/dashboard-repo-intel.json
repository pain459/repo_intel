  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "title": "Service Start Time",
      "description": "When this API process launched",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "process_start_time_seconds * 1000",
          "legendFormat": "start",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "Resident Memory",
      "description": "Process RSS — helps detect memory leaks",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1073741824 },
              { "color": "red", "value": 2147483648 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "Open File Descriptors",
      "description": "Open FDs — high counts can indicate connection / file handle leaks",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "targets": [
        { "expr": "process_open_fds", "legendFormat": "FDs", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "DB Pool Used",
      "description": "Active connections from the pool. Pool size = 5, max overflow = 10",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "targets": [
        { "expr": "repo_intel_db_pool_used", "legendFormat": "used", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "red", "value": 14 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "HTTP Traffic",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 10
    },
    {
      "title": "Request Rate (req/min)",
      "description": "Total HTTP requests per minute across all endpoints (excludes /metrics and /health)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 5 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) * 60",
          "legendFormat": "req/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "P95 Latency",
      "description": "95th percentile HTTP request latency across all endpoints",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 5 },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "P99 Latency",
      "description": "99th percentile HTTP request latency across all endpoints",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 5 },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "title": "Requests Over Time",
      "description": "HTTP request rate per minute, grouped by status class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 14,
      "targets": [
        {
          "expr": "sum by (status_class) (rate(http_requests_total[5m])) * 60",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "palette-classic",
            "seriesBy": "last"
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "Latency Percentiles",
      "description": "HTTP request latency at p50 / p90 / p95 / p99 over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 15,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "fixedColor": "blue",
            "mode": "palette-classic"
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "5xx / 4xx Response Rate",
      "description": "Fraction of requests returning 5xx or 4xx status codes",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 17 },
      "id": 30,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_class=\"5xx\"}[5m])) / (sum(rate(http_requests_total[5m])) or vector(1))",
          "legendFormat": "5xx rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{status_class=\"4xx\"}[5m])) / (sum(rate(http_requests_total[5m])) or vector(1))",
          "legendFormat": "4xx rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "fixedColor": "red",
            "mode": "palette-classic"
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "yaxes": [
        { "min": 0, "max": 1 }
      ]
    },
    {
      "title": "In-Flight Requests",
      "description": "Currently active HTTP requests being processed",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 17 },
      "id": 31,
      "targets": [
        {
          "expr": "sum by (endpoint) (http_requests_active)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
