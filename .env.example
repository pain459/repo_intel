# repo_intel configuration
# Copy to .env and edit. Do NOT commit .env.

# Profile: local | remote-ollama
REPO_INTEL_PROFILE=remote-ollama

# Server bind (default 127.0.0.1 for loopback-only)
REPO_INTEL_HOST=0.0.0.0
REPO_INTEL_PORT=8765

# PostgreSQL connection (from inside the container)
DATABASE_URL=postgresql+psycopg://repo_intel:CHANGE_ME@postgres:5432/repo_intel

# Repository roots mounted into the container (read-only)
REPO_ROOTS=/workspace

# Ollama endpoint — adjust for your deployment
OLLAMA_BASE_URL=http://192.168.68.62:11434

# Embedding model (used in Phase 2+)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=16

# Indexing (Phase 2+)
INDEX_POLL_SECONDS=10
MAX_FILE_BYTES=1048576
DEFAULT_CONTEXT_TOKENS=12000

# Logging
LOG_LEVEL=INFO
